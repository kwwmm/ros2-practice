
# ==========================================
# ROS2 Practice - Git Ignore
# Ubuntu 24.04 / ROS2 Jazzy / Python 3.12
# ==========================================

# ROS2 / Colcon build artifacts
build/
install/
log/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Python virtual environments
.venv/
venv/
env/

# Python packaging
*.egg-info/
.eggs/
dist/
*.whl

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter Notebook
.ipynb_checkpoints/

# OS generated files
.DS_Store
Thumbs.db

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Logs and temporary files
*.log
*.tmp
*.bak

# Machine Learning / Reinforcement Learning
checkpoints/
runs/
wandb/
tensorboard/
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.hdf5
*.tflite

# ROS2 recorded data
*.db3
*.mcap

# Large datasets and recordings
datasets/
*.bag
*.npy
*.npz

# Gazebo / Simulation cache
.gazebo/
.gz/
